package bytebank_herdado;

//Gerente é um funcionário / Gerente herda da classe Funcionário
public class Gerente extends Funcionario {

	private int senha;
	
	public void setSenha(int senha) {
		this.senha = senha;
	}
	
	public boolean autenticacao(int senha) {
		if (this.senha == senha) {
			return true;
		} else {
			return false;
		}
	}
	
	/* reescrita metodo bonificacao, com mesmo retorno, double, 
	 * mesma assinatura, getBonificacao e mesmos parâmetros, ().*/
	//super = utilizado para indicar atributo da classe mãe, da super classe.
	public double getBonificacao() {
		return (super.salario * 0.1) + super.salario;
	}
	

}
